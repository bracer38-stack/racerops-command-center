# Required: choose a unique password of at least 16 characters. Never commit .env.
HUB_PASSWORD=
DATABASE_PATH=./data/racerops.sqlite
PORT=3001
# Development origin; production MUST be the deployed HTTPS origin, with no path.
APP_URL=http://localhost:5173
TRUST_PROXY=0
# Optional n8n ingestion: a random secret of at least 32 characters.
WEBHOOK_SECRET=
# Required for cloud OAuth: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional; without a key the assistant searches the DB without external calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
